# Durable persistence is the default in every runtime. Use memory only as an
# explicit fallback for unit tests or disposable offline demos.
PERSISTENCE_PROVIDER=postgres
DATABASE_URL=postgres://creative_graph:creative_graph@localhost:54329/creative_graph_test
# Integration tests create and delete fixture data. Never use a production URL.
POSTGRES_TEST_DATABASE_URL=postgres://creative_graph:creative_graph@localhost:54329/creative_graph_test
WORKFLOW_CHECKPOINTER=postgres
# Optional: omit this to reuse DATABASE_URL.
WORKFLOW_DATABASE_URL=postgres://creative_graph:creative_graph@localhost:54329/creative_graph_test
WORKFLOW_CHECKPOINT_SCHEMA=langgraph

# DeepSeek API（服务端使用，不要以 NEXT_PUBLIC_ / VITE_ 开头）
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 请求控制
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_TOKENS=8192
OPENAI_RETRY_MAX=2

# 本地 demo 模式：mock | deepseek
# mock = 不调用真实 API，返回固定候选，无 Key 时也能跑通完整演示（PRD 9.1 要求）
# deepseek = 调用真实 DeepSeek API（需要填写上面的 OPENAI_API_KEY）
CREATIVE_MODEL_PROVIDER=mock
RETRIEVAL_PROVIDER=mock
# For RETRIEVAL_PROVIDER=real, the endpoint accepts RetrievalQuery JSON and
# returns RetrievalResult JSON. Keep RETRIEVAL_API_KEY server-side only.
RETRIEVAL_ENDPOINT=
RETRIEVAL_API_KEY=
RETRIEVAL_TIMEOUT_MS=15000

# Creative Case Skill 是默认上下文机制。auto 会让 Selector 最多选择两个案例模式；
# disabled 用于无 Few-shot 对照实验。RAG 仅在 API 明确 needRag=true 时兼容启用。
CREATIVE_CASE_SKILL_MODE=auto
